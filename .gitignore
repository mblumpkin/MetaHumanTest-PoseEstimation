# This git repo (github.com/mblumpkin/MetaHumanTest-PoseEstimation) tracks ONLY the pose estimation work inside the
# MetaHumanTest Unreal project. Everything else stays in Perforce. Ignore everything, then allow the pose files back in.

/*

!/.gitignore
!/.gitattributes
!/.github/

!/MetaHumanTest.uproject

!/Source/
/Source/*
!/Source/MetaHumanTest.Target.cs
!/Source/MetaHumanTest/
/Source/MetaHumanTest/*
!/Source/MetaHumanTest/MetaHumanTest.Build.cs
!/Source/MetaHumanTest/CPP_PlayerController.h
!/Source/MetaHumanTest/CPP_PlayerController.cpp
!/Source/MetaHumanTest/Public/
/Source/MetaHumanTest/Public/*
!/Source/MetaHumanTest/Public/PoseEstimation/
!/Source/MetaHumanTest/Private/
/Source/MetaHumanTest/Private/*
!/Source/MetaHumanTest/Private/PoseEstimation/

!/PoseModels/

!/Tools/
/Tools/*
!/Tools/PoseEstimation/

!/README/
/README/*
!/README/08_Pose_Estimation.md
!/README/images/
/README/images/*
!/README/images/pose_*.png

__pycache__/

# Phase 4: the pose buttons' pictures (made by Tools/PoseEstimation/make_pose_button_textures.py) and their Unreal assets
!/SourceArt/
/SourceArt/*
!/SourceArt/Figma/
/SourceArt/Figma/*
!/SourceArt/Figma/UE/
/SourceArt/Figma/UE/*
!/SourceArt/Figma/UE/T_IHPC_PB_*.png

!/Content/
/Content/*
!/Content/UserInterface/
/Content/UserInterface/*
!/Content/UserInterface/IHPC/
/Content/UserInterface/IHPC/*
!/Content/UserInterface/IHPC/Textures/
/Content/UserInterface/IHPC/Textures/*
!/Content/UserInterface/IHPC/Textures/T_IHPC_PB_*.uasset
